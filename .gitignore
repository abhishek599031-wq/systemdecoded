# --------------------------------------------------------------- secrets ---
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
# OAuth token stores must never be committed.
credentials.json
token.json

# ---------------------------------------------------------------- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# ------------------------------------------------------------------ node ---
# Dependencies may exist in multiple nested frontend/POC workspaces.
node_modules/
**/node_modules/
.next/
out/
**/.next/
**/out/
media_engine/motion_canvas/output/
media_engine/motion_canvas/output-*/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ----------------------------------------------------------------- media ---
# Renders are reproducible from the database; source assets and published
# masters are not, so back those up separately (README: Known limitations).
#
# Ignore contents (trailing /*), not the directories themselves — git cannot
# re-include a file via negation if a parent directory is excluded outright,
# so `media/renders/` + `!media/**/.gitkeep` silently drops the .gitkeep too.
media/renders/*
media/cache/*
media/assets/*
media/proofs/*
# Local auditions and renderer proofs are review artifacts, not fixtures.
media/pocs/
!media/renders/.gitkeep
!media/cache/.gitkeep
!media/assets/.gitkeep
!media/proofs/.gitkeep

# ------------------------------------------------------------------- misc ---
# Local POC virtual environments/model caches are never source files.
.poc/
**/.poc/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
.poc
*.poc/
chatterbox-cache/
