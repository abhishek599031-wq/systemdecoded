# =============================================================================
# SystemDecoded — environment configuration
#
# Copy to .env and adjust:   cp .env.example .env
# The defaults below run the full local stack with no edits.
# =============================================================================

# ----------------------------------------------------------------------- app
APP_NAME=SystemDecoded
APP_TAGLINE=Complex Technology. Decoded.
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------ database
# Credentials PostgreSQL is created with (used by the postgres service).
POSTGRES_USER=systemdecoded
POSTGRES_PASSWORD=systemdecoded
POSTGRES_DB=systemdecoded
POSTGRES_PORT=5432

# How the application connects. Inside Docker the host is the service name;
# running the backend on the host instead, use localhost.
DATABASE_URL=postgresql+psycopg://systemdecoded:systemdecoded@postgres:5432/systemdecoded
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ------------------------------------------------------------------- logging
LOG_LEVEL=INFO
# console = human readable (development), json = structured (production)
LOG_FORMAT=console

# -------------------------------------------------------------------- worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_POLL_JITTER_SECONDS=0.3
WORKER_HEARTBEAT_SECONDS=10
WORKER_SHUTDOWN_GRACE_SECONDS=30
# Comma-separated job types this worker will claim. Empty = claim anything.
# Phase 2 uses this to move media rendering onto a dedicated worker.
WORKER_JOB_TYPES=

# ----------------------------------------------------------------- job queue
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_DEFAULT_TIMEOUT_SECONDS=300
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=3600
JOB_HISTORY_RETENTION_DAYS=90

# ----------------------------------------------------------------- scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# --------------------------------------------------------------------- media
MEDIA_ROOT=/media

# ------------------------------------------------------ production (Phase 2)
# Narration voice. Any Kokoro voice id; list them with:
#   docker compose exec worker python -c "import asyncio;from app.providers.tts.kokoro import KokoroTTS;print(asyncio.run(KokoroTTS().list_voices()))"
# am_puck was chosen for the widest prosodic range (≈13 semitones) and the
# lowest sibilance of the candidates tested — it reads as explaining rather
# than reciting. Samples for the shortlist are kept in media/renders/_voices/.
TTS_VOICE=am_puck
# ~178 wpm at 0.92. Higher is brisker; below ~0.85 starts to drag.
TTS_SPEED=0.92
TTS_LANG=en-us
ALIGNMENT_MODEL=base.en

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_TARGET_LUFS=-14.0

# Seconds the picture holds on the resolved final frame after narration ends,
# so the video reads as finished rather than cut off.
END_HOLD_SECONDS=1.0

# Shorts duration band. QC fails a render outside it.
TARGET_DURATION_MIN_SECONDS=20
TARGET_DURATION_MAX_SECONDS=45

# ------------------------------------------------------------------- secrets
# Encrypts OAuth tokens at rest (Phase 1). Required in production.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# ----------------------------------------------------------- youtube (Phase 1)
# Implemented in Phase 1. The application still starts and runs fully with these
# blank — only the YouTube endpoints report themselves as unconfigured.
#
# SECRETS_KEY above is REQUIRED once YOUTUBE_API_ENABLED=true: the app refuses to
# store OAuth tokens unencrypted.
#
# From Google Cloud Console you need:
#   1. A project with YouTube Data API v3 AND YouTube Analytics API enabled
#   2. An OAuth 2.0 Client ID of type "Web application"
#   3. The consent screen set to External + **In Production**
#      (in Testing, refresh tokens expire after 7 days — ARCH §3.3)
#   4. Both redirect URIs registered (localhost for dev, https for production)
YOUTUBE_API_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/youtube/oauth/callback

# Declared, not detected — nothing in the API reports the consent screen's
# publishing status. While it is "testing", Google expires refresh tokens after
# 7 days and the dashboard shows a warning. Set to "production" once you have
# switched the consent screen over in Google Cloud Console.
GOOGLE_CONSENT_PUBLISHING_STATUS=testing

# Where the OAuth callback sends the browser when it is done.
FRONTEND_URL=http://localhost:3030

# Refresh the access token once it is within this many seconds of expiring.
OAUTH_REFRESH_SKEW_SECONDS=600

# --------------------------------------------------------------- llm (Phase 4)
# Hybrid provider model (ARCH §2.1): LOCAL for mechanical work, MANUAL for
# creative work (hooks and scripts), EXTERNAL_API as a later drop-in.
LLM_MECHANICAL_MODE=local
LLM_CREATIVE_MODE=manual
LLM_LOCAL_BASE_URL=http://host.docker.internal:11434
LLM_LOCAL_MODEL=qwen2.5:7b-instruct

# ----------------------------------------------------------------------- cors
CORS_ORIGINS=http://localhost:3030

# ------------------------------------------------------------------- frontend
BACKEND_PORT=8080
FRONTEND_PORT=3030
# Browser-side API base URL (must be reachable from your browser, not the container).
NEXT_PUBLIC_API_URL=http://localhost:8080
