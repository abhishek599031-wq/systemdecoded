{
  "version": 1,
  "shared": {
    "background": "rgb(3,7,18)",
    "range": [0, 60],
    "size": {"x": 1080, "y": 1920},
    "audioOffset": 0
  },
  "preview": {"fps": 30, "resolutionScale": 1},
  "rendering": {
    "fps": 30,
    "resolutionScale": 1,
    "colorSpace": "srgb",
    "exporter": {
      "name": "@motion-canvas/core/image-sequence",
      "options": {"fileType": "image/png", "quality": 100, "groupByScene": false}
    }
  }
}
